# Copy this file to .mac-release.env and fill in the public release metadata.
# Keep .mac-release.env local; it is ignored by git.

AGENTMICRO_GITHUB_REPOSITORY=fizzy718/AgentMicro
AGENTMICRO_FEED_BRANCH=main
AGENTMICRO_FEED_URL=https://raw.githubusercontent.com/fizzy718/AgentMicro/main/agentmicro-appcast.xml
AGENTMICRO_PUBLIC_ED_KEY=replace-with-agentmicro-ed25519-public-key
AGENTMICRO_SPARKLE_ACCOUNT=agentmicro
AGENTMICRO_BUNDLE_ID=com.agentmicro.macos
AGENTMICRO_SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID)'

# Optional: use an exported Sparkle key instead of the dedicated Keychain account.
# SPARKLE_PRIVATE_KEY_FILE=/absolute/path/to/agentmicro-sparkle-private-key

# Apple notarization credentials. Prefer exporting these only in the release shell
# or providing them through CI secrets instead of storing the P8 value here.
# APP_STORE_CONNECT_KEY_ID=ABC123DEFG
# APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APP_STORE_CONNECT_API_KEY_P8='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'

# Optional release notes file used by generate_appcast and gh release create.
# AGENTMICRO_RELEASE_NOTES_FILE=/absolute/path/to/release-notes.md
